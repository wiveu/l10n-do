<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="l10n_do_dgii_reports.UrlDgiiReportsWidget">
        <div class="o_field_widget o_field_url">
            <a t-if="isVisible and props.readonly" 
               t-att-href="href" 
               target="_blank" 
               class="o_form_uri o_text_overflow">
                <t t-esc="text"/>
            </a>
            <input t-elif="!props.readonly" 
                   type="url" 
                   class="o_input" 
                   t-att-value="text"
                   t-on-change="(ev) => props.record.update({[props.name]: ev.target.value})"/>
        </div>
    </t>
</templates>
