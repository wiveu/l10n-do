<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_res_config_settings_inherit_dgii" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.dgii</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="DGII" name="dgii_setting_container">
                    <setting id="l10n_do_is_subject_to_proportionality" string="Subject to Proportionality" 
                             help="All purchase invoices will be subject to proportionality." 
                             groups="account.group_account_user">
                        <field name="l10n_do_is_subject_to_proportionality"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>