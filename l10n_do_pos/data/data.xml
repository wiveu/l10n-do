<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default partner for POS orders without customer -->
        <record model="res.partner" id="default_pos_partner">
            <field name="name">Consumidor Final</field>
            <field name="is_company">False</field>
        </record>

        <!-- Credit Note payment method -->
        <record model="pos.payment.method" id="credit_note">
            <field name="name">Nota de Credito</field>
            <field name="split_transactions">True</field>
            <field name="is_credit_note">True</field>
        </record>

        <!--
        Note: pos_config_main records removed because they reference demo data
        that may not exist in production. Configure POS manually:
        1. Go to POS > Configuration > Point of Sale
        2. Set Default Partner to "Consumidor Final"
        3. Add "Credit Note" payment method
        -->
    </data>
</odoo>